h1,h2,h3,h4,h5,h6,p {
	font-family: 'Roboto', sans-serif;
	font-weight: 700;
}

.container {
	height: 100vh;
	display: flex;
	justify-content: center;
	align-items: center;
}

/*.card {
	margin-bottom: 1.5rem;
	border: none;
}*/

.card {
            background: rgba(255, 255, 255, 0.95);
            transition: all 500ms cubic-bezier(0.19, 1, 0.22, 1);
            overflow: hidden;
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 48px 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            
        }



.loginHeading{
	letter-spacing: 3px;
	font-weight: 800;
}
.box {
	display: flex;
	border: none;
	flex-direction: column;
	gap: 1rem;
	width: 30rem;
	padding: 2rem;
}

.logo{
	width:100px;
	height:100px;
}

input[type="text"], input[type="password"] {
	background-color: rgb(209, 211, 213);
	border: 2px solid white;
	padding: 1rem 1.8rem;
	outline: none;
	font-weight:600;
}

input[type="text"]:focus, input[type="password"]:focus {
	transition: border 0.5s ease-out;
	border-color: rgb(32,154,98);
}

.submitBtn {
	padding: 0.8rem;
	background-color: rgb(32,154,98);
	border: none;
	color: #fff;
	font-size: 1.5rem;
	outline: none;
	border: 2px solid white;
}

.submitBtn:focus {
	border: 2px solid #000;
}

@media (max-width:480px) {
	:root {
		font-size: 13px;
	}
	.box {
		width: 24rem;
	}
}